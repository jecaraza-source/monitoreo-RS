# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local.
# Las variables NEXT_PUBLIC_* se exponen al navegador; el resto es sólo de servidor.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sólo servidor: omite RLS. Úsala únicamente en jobs/cron y Server Actions de admin.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo rápido para clasificar menciones (sentimiento, tema, dependencia, colonia, prioridad)
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Modelo para reportes con narrativa estratégica
CLAUDE_MODEL_SMART=claude-opus-5-5

# --- Meta (Graph API: páginas públicas de Facebook/Instagram) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# --- Resend (correo de alertas y reportes) ---
RESEND_API_KEY=re_...
EMAIL_FROM="Monitoreo Municipal <alertas@tu-dominio.gob.mx>"

# --- Vercel Cron ---
# Vercel la envía como "Authorization: Bearer <CRON_SECRET>" en cada cron.
CRON_SECRET=

# --- App ---
# Base of the links in magic-link and invitation emails. Must be listed in
# Supabase Auth > URL Configuration (Site URL / Redirect URLs, e.g. https://dominio/**).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
